[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/ui/hud.gd" id="1"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1")

[node name="MainContainer" type="MarginContainer" parent="."]
theme_override_constants/margin_top = 20
theme_override_constants/margin_left = 20
theme_override_constants/margin_right = 20

[node name="VBoxContainer" type="VBoxContainer" parent="MainContainer"]

[node name="TopBar" type="HBoxContainer" parent="MainContainer/VBoxContainer"]

[node name="ScoreLabel" type="Label" parent="MainContainer/VBoxContainer/TopBar"]
text = "Score: 0"
horizontal_alignment = 0
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 2

[node name="CollectiblesLabel" type="Label" parent="MainContainer/VBoxContainer/TopBar"]
text = "Collectibles: 0 / 0"
horizontal_alignment = 0
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(1, 0.9, 0.3, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 2
theme_override_constants/margin_left = 20

[node name="Spacer" type="Control" parent="MainContainer/VBoxContainer/TopBar"]
custom_minimum_size = Vector2(0, 0)
size_flags_horizontal = 3

[node name="ObjectiveLabel" type="Label" parent="MainContainer/VBoxContainer/TopBar"]
text = "Find the exit"
horizontal_alignment = 2
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(1, 1, 0.8, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 2

[node name="InteractionPrompt" type="Label" parent="MainContainer/VBoxContainer"]
text = ""
visible = false
horizontal_alignment = 1
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.8, 1, 0.8, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 2
theme_override_constants/margin_top = 20

[node name="FailureMessage" type="PanelContainer" parent="MainContainer/VBoxContainer"]
visible = false
horizontal_alignment = 1
theme_override_constants/margin_top = 100

[node name="FailureLabel" type="Label" parent="MainContainer/VBoxContainer/FailureMessage"]
text = ""
horizontal_alignment = 1
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(1, 0.5, 0.3, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_right = 40
theme_override_constants/margin_top = 20
theme_override_constants/margin_bottom = 20
autowrap_mode = 2

[node name="BottomSpacer" type="Control" parent="MainContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 0)
size_flags_vertical = 3

[node name="ControlsHint" type="Label" parent="MainContainer/VBoxContainer"]
text = "WASD: Move  |  Space: Jump  |  Shift: Gravity Shift  |  E: Interact  |  ESC: Pause"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 0.8)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.5)
theme_override_constants/outline_size = 1